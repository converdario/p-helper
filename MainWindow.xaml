<Window x:Class="PHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PHelper"
        Title="P-Helper" Height="450" Width="600" WindowStartupLocation="CenterScreen"
        Icon="favicon.ico"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <local:IconConverter x:Key="IconConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <DataGrid x:Name="ProfilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" Grid.Row="0" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Process Name" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                                <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}}" Width="16" Height="16" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="GHelper CPU Profile" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ItemsSource, ElementName=DefaultModeComboBox}" 
                                    SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" 
                                    SelectionChanged="ProfileComboBox_SelectionChanged"
                                    VerticalContentAlignment="Center" Margin="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove" Click="RemoveProfile_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Default Profile:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="DefaultModeComboBox" Width="90" Height="22" VerticalContentAlignment="Center" SelectionChanged="DefaultModeComboBox_SelectionChanged"/>
                    
                    <TextBlock Text="Current Mode: " VerticalAlignment="Center" Margin="20,0,5,0"/>
                    <TextBlock Name="CurrentModeText" Text="Unknown" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Avvia con Windows" VerticalAlignment="Center" Margin="0,0,15,0" Click="StartWithWindowsCheckBox_Click"/>
                    <ComboBox Name="PauseDurationComboBox" Width="90" Margin="0,0,5,0" Height="22" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="1 Hour" Tag="1" />
                        <ComboBoxItem Content="4 Hours" Tag="4" />
                        <ComboBoxItem Content="8 Hours" Tag="8" />
                        <ComboBoxItem Content="24 Hours" Tag="24" />
                        <ComboBoxItem Content="Indefinitely" Tag="0" IsSelected="True" />
                    </ComboBox>
                    <Button Name="PauseResumeButton" Content="Pause" Width="60" Height="22" Click="PauseResumeButton_Click" />
                </StackPanel>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2">
                <Button Content="Add Current App" Width="120" Height="30" Click="AddCurrentApp_Click" />
                <Button Content="Scan Folders..." Width="100" Height="30" Margin="10,0,0,0" Click="ScanFolders_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>