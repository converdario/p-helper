<Window x:Class="PHelper.ScannerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PHelper"
        Title="Scan Game Folders" Height="450" Width="600" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:IconConverter x:Key="IconConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <ListBox Name="FoldersListBox" Grid.Column="0" Height="80" Margin="0,0,10,0"/>
            
            <StackPanel Grid.Column="1">
                <Button Content="Add Folder..." Click="AddFolder_Click" Margin="0,0,0,5" Padding="5"/>
                <Button Content="Remove" Click="RemoveFolder_Click" Padding="5"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="ResultsListBox" Grid.Row="1" Margin="0,10,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,4,2,4">
                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Confirm" Width="100" Margin="0,0,10,0" Click="AddSelected_Click" />
            <Button Content="Cancel" Width="60" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>